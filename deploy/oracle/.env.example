# Đây là mẫu công khai, chỉ chứa tên biến và giá trị minh họa.
# Sao chép thành deploy/oracle/.env trên máy chủ rồi chmod 600. Không commit tệp thật.
API_DOMAIN=api.ecomtech.congtc145.id.vn
NODE_ENV=production
PORT=3000

POSTGRES_DB=ecomtech
POSTGRES_USER=ecomtech
# Dùng chuỗi hexadecimal tạo bởi: openssl rand -hex 32
# Giữ cùng một giá trị ở POSTGRES_PASSWORD và phần mật khẩu trong DATABASE_URL.
POSTGRES_PASSWORD=thay-bang-mat-khau-database-dai-va-ngau-nhien
DATABASE_URL=postgresql://ecomtech:thay-bang-mat-khau-database-dai-va-ngau-nhien@postgres:5432/ecomtech?schema=public

CORS_ORIGIN=https://bepdubanh.congtc145.id.vn
SESSION_TTL_DAYS=30
# TRUST_PROXY_HOPS=1 do compose.production.yaml đặt khi API chỉ được Caddy gọi qua mạng Docker nội bộ.
PUBLIC_WEB_URL=https://bepdubanh.congtc145.id.vn
# Oracle Email Delivery: lấy endpoint SMTP đúng region, approved sender và SMTP credentials trong OCI.
SMTP_HOST=replace-with-public-endpoint-from-OCI-Email-Delivery-Configuration
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Bep Du Banh <no-reply@example.com>"

# Lấy APP_ID, KEY1, KEY2 từ ZaloPay Sandbox. Không dùng khóa trong mã nguồn demo.
# Cần cấu hình đủ năm biến đầu tiên dưới đây mới bật ZaloPay.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=https://api.ecomtech.congtc145.id.vn/api/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=https://bepdubanh.congtc145.id.vn/thanh-toan/ket-qua
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_EXPIRE_SECONDS=900
