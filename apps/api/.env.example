NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ecomtech:ecomtech_local@localhost:5433/ecomtech?schema=public
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_DAYS=30

# Để trống toàn bộ nhóm ZaloPay khi chưa tích hợp Sandbox.
# Khi bật, cần cấu hình đủ APP_ID, KEY1, KEY2, callback và redirect.
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# ZALOPAY_CALLBACK_URL=https://api.example.com/api/payments/zalopay/callback
# ZALOPAY_REDIRECT_URL=http://localhost:5173/thanh-toan/ket-qua
# ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
# ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
# ZALOPAY_EXPIRE_SECONDS=900

# Tùy chọn: bỏ dấu # và đổi giá trị trong .env để db:seed tạo tài khoản quản trị.
# Không dùng lại mật khẩu này trên dịch vụ khác và không commit file .env.
# SEED_ADMIN_DISPLAY_NAME=Quản trị viên
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=thay-bang-mat-khau-rieng

# Tùy chọn: tạo thêm một tài khoản khách hàng riêng để kiểm tra luồng mua hàng.
# SEED_CUSTOMER_DISPLAY_NAME=Khách hàng thử nghiệm
# SEED_CUSTOMER_EMAIL=customer@example.test
# SEED_CUSTOMER_PASSWORD=thay-bang-mat-khau-rieng-khac
