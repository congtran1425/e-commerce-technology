generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MeasurementUnit {
  GRAM
  MILLILITER
  PIECE
}

enum ProductKind {
  INGREDIENT
  TOOL
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PAYMENT_REVIEW
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

model Recipe {
  id           BigInt             @id @default(autoincrement())
  slug         String             @unique @db.VarChar(160)
  title        String             @db.VarChar(180)
  summary      String             @db.VarChar(500)
  story        String             @db.Text
  imageUrl     String?            @map("image_url") @db.VarChar(500)
  baseServings Int                @map("base_servings") @db.SmallInt
  prepMinutes  Int                @map("prep_minutes") @db.SmallInt
  bakeMinutes  Int                @map("bake_minutes") @db.SmallInt
  temperatureC Int?               @map("temperature_c") @db.SmallInt
  difficulty   Difficulty
  published    Boolean            @default(false)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  ingredients  RecipeIngredient[]
  tools        RecipeTool[]
  steps        RecipeStep[]

  @@map("recipes")
}

model RecipeStep {
  id           BigInt  @id @default(autoincrement())
  recipeId     BigInt  @map("recipe_id")
  stepNumber   Int     @map("step_number") @db.SmallInt
  title        String? @db.VarChar(180)
  instruction  String  @db.Text
  durationMinutes Int? @map("duration_minutes") @db.SmallInt
  temperatureC Int?    @map("temperature_c") @db.SmallInt
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId, stepNumber])
  @@map("recipe_steps")
}

model Ingredient {
  id       BigInt              @id @default(autoincrement())
  slug     String              @unique @db.VarChar(160)
  name     String              @db.VarChar(180)
  unit     MeasurementUnit
  recipes  RecipeIngredient[]
  variants IngredientVariant[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipeId     BigInt     @map("recipe_id")
  ingredientId BigInt     @map("ingredient_id")
  quantity     Decimal    @db.Decimal(12, 3)
  note         String?    @db.VarChar(300)
  sortOrder    Int        @map("sort_order") @db.SmallInt
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([recipeId, sortOrder])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model Tool {
  id       BigInt        @id @default(autoincrement())
  slug     String        @unique @db.VarChar(160)
  name     String        @db.VarChar(180)
  recipes  RecipeTool[]
  variants ToolVariant[]

  @@map("tools")
}

model RecipeTool {
  recipeId  BigInt  @map("recipe_id")
  toolId    BigInt  @map("tool_id")
  required  Boolean @default(true)
  sortOrder Int     @map("sort_order") @db.SmallInt
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@id([recipeId, toolId])
  @@index([recipeId, sortOrder])
  @@index([toolId])
  @@map("recipe_tools")
}

model Product {
  id          BigInt           @id @default(autoincrement())
  slug        String           @unique @db.VarChar(160)
  name        String           @db.VarChar(180)
  description String           @db.VarChar(500)
  kind        ProductKind
  imageUrl    String?          @map("image_url") @db.VarChar(500)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                 BigInt              @id @default(autoincrement())
  productId          BigInt              @map("product_id")
  sku                String              @unique @db.VarChar(80)
  label              String              @db.VarChar(180)
  unit               MeasurementUnit
  packageQuantity    Decimal             @map("package_quantity") @db.Decimal(12, 3)
  price              Decimal             @db.Decimal(14, 2)
  currency           String              @default("VND") @db.Char(3)
  stockQuantity      Int                 @default(0) @map("stock_quantity")
  active             Boolean             @default(true)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  ingredientMappings IngredientVariant[]
  toolMappings       ToolVariant[]
  orderItems         OrderItem[]

  @@index([productId, active])
  @@map("product_variants")
}

model IngredientVariant {
  ingredientId    BigInt         @map("ingredient_id")
  productVariantId BigInt        @map("product_variant_id")
  priority        Int            @default(0) @db.SmallInt
  ingredient      Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@id([ingredientId, productVariantId])
  @@index([productVariantId])
  @@map("ingredient_variants")
}

model ToolVariant {
  toolId           BigInt         @map("tool_id")
  productVariantId BigInt         @map("product_variant_id")
  priority         Int            @default(0) @db.SmallInt
  tool             Tool           @relation(fields: [toolId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@id([toolId, productVariantId])
  @@index([productVariantId])
  @@map("tool_variants")
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(254)
  displayName  String    @map("display_name") @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  orders       Order[]

  @@map("users")
}

model Session {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Order {
  id                 BigInt      @id @default(autoincrement())
  orderNumber        String      @unique @map("order_number") @db.VarChar(24)
  idempotencyKey     String      @unique @map("idempotency_key") @db.Uuid
  userId             BigInt      @map("user_id")
  status             OrderStatus @default(AWAITING_PAYMENT)
  currency           String      @default("VND") @db.Char(3)
  subtotal           Decimal     @db.Decimal(14, 2)
  shippingFee        Decimal     @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  total              Decimal     @db.Decimal(14, 2)
  recipientName      String      @map("recipient_name") @db.VarChar(100)
  recipientPhone     String      @map("recipient_phone") @db.VarChar(20)
  addressLine        String      @map("address_line") @db.VarChar(250)
  ward               String?     @db.VarChar(120)
  district           String      @db.VarChar(120)
  province           String      @db.VarChar(120)
  note               String?     @db.VarChar(500)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payments           Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id               BigInt          @id @default(autoincrement())
  orderId          BigInt          @map("order_id")
  productVariantId BigInt?         @map("product_variant_id")
  productName      String          @map("product_name") @db.VarChar(180)
  sku              String          @db.VarChar(80)
  variantLabel     String          @map("variant_label") @db.VarChar(180)
  quantity         Int             @db.SmallInt
  unitPrice        Decimal         @map("unit_price") @db.Decimal(14, 2)
  lineTotal        Decimal         @map("line_total") @db.Decimal(14, 2)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model Payment {
  id                      BigInt          @id @default(autoincrement())
  orderId                 BigInt          @map("order_id")
  provider                PaymentProvider
  status                  PaymentStatus   @default(PENDING)
  amount                  Decimal         @db.Decimal(14, 2)
  merchantTransactionId   String          @unique @map("merchant_transaction_id") @db.VarChar(40)
  providerTransactionId   String?         @map("provider_transaction_id") @db.VarChar(50)
  checkoutUrl             String?         @map("checkout_url") @db.VarChar(2048)
  providerToken           String?         @map("provider_token") @db.VarChar(512)
  returnCode              Int?            @map("return_code")
  returnMessage           String?         @map("return_message") @db.VarChar(500)
  expiresAt               DateTime        @map("expires_at") @db.Timestamptz(3)
  paidAt                  DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}
